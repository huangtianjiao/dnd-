# ─────────────────────────────────────────────────────────────
# AIDM 环境变量示例
# 复制为 .env（默认路径 D:\game\dnd\.env，可由 AIDM_ENV_FILE 覆盖）
# ─────────────────────────────────────────────────────────────

# ─── LLM（必填）──────────────────────────────────────────────
# senseaudio 网关 API Key（OpenAI 兼容端点）
# config.py 通过 validation_alias="key" 映射为 llm_api_key
key=your-senseaudio-api-key-here

# ─── LLM 可选覆盖（均有代码默认值，保持注释即可）─────────────
# LLM 接口地址
# LLM_BASE_URL=https://api.senseaudio.cn/v1
# LLM 模型名
# LLM_MODEL=deepseek-v4-flash

# ─── 嵌入模型可选覆盖 ────────────────────────────────────────
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIM=512
# 注意：如改用 bge-m3（1024 维）需重建 Qdrant 集合

# ─── Qdrant 可选覆盖 ─────────────────────────────────────────
# 本地文件模式（免 docker）：QDRANT_URL 不使用
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=dnd_rules        # data.js 语料
# QDRANT_RULE_COLLECTION=dnd_rule_text  # 判定规则文本

# ─── 规则数据路径可选覆盖 ────────────────────────────────────
# RULES_DATAJS_PATH=D:\game\dnd\5echm_web\data.js
# RULES_TOPICS_DIR=D:\game\dnd\5echm_web\topics
# RULES_TEXT_DIR=D:\game\dnd\aidm\data\rules_text

# ─── 部署可选配置 ───
# 空房间销毁延迟（秒），默认 120
# ROOM_DISPOSE_DELAY=120

# ─── 安全配置（可选，不设置时行为不变）────────────────────────────
# API Key 认证，设置后所有 API 端点需携带 X-API-Key 请求头
# AIDM_API_KEY=your-secret-key-here
# CORS 允许的来源（逗号分隔），默认 * 允许所有
# AIDM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Redis 缓存（可选，留空则禁用）──────────────────────────────
# REDIS_URL=redis://localhost:6379/0
